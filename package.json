{
  "name": "cortico-world-screen-sense",
  "version": "0.1.2",
  "type": "module",
  "description": "Cortico World：屏幕感知——把前台应用切换变成事件，截图留在相册，辅助视觉模型写一句话描述；默认关闭，原图不进上下文。",
  "author": "Wwhois163wW",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wwhois163wW/cortico-world-screen-sense.git"
  },
  "homepage": "https://github.com/Wwhois163wW/cortico-world-screen-sense#readme",
  "bugs": {
    "url": "https://github.com/Wwhois163wW/cortico-world-screen-sense/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "screen",
    "vision",
    "album"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "屏幕感知",
    "tags": ["memory", "external-setup", "experimental", "sensitive-data"],
    "icon": "assets/icon.svg",
    "locales": {
      "en": { "displayName": "Screen sense", "description": "Focus events, a screenshot album and one-line vision descriptions; the images stay out of the context unless asked for. Off by default." }
    },
    "webUiClient": "dist/webui.js",
    "webUiStyle": "dist/webui.css",
    "describe": "describe.json"
  },
  "files": [
    "src",
    "assets",
    "dist",
    "describe.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-webui.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "koffi": "3.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.12",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
